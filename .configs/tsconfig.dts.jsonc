{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true, // helpful for IDEs
		"rootDir": "..",
		"outDir": ".././types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true // hides /** @internal */ if you use it
	},
	// Declarations are generated from src/ only: types/src/index.d.mts is what package.json's
	// "types" fields point at, for both the "." entry and the deprecated "./main" alias.
	"include": ["../src/**/*.mjs"],
	"exclude": ["../node_modules", "../tests", "../dist", "../types"]
}
